{
  "info": {
    "name": "MediWise Clinical System API",
    "_postman_id": "mediwise-api-v1",
    "description": "Comprehensive Postman collection for MediWise Clinical Decision and Consultation Platform covering Auth, Doctor Discovery, Slot Booking, Payments, Appointment Lifecycle, Chat/WebRTC signaling, and Admin Operations.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080", "type": "string" },
    { "key": "patientToken", "value": "", "type": "string" },
    { "key": "doctorToken", "value": "", "type": "string" },
    { "key": "adminToken", "value": "", "type": "string" },
    { "key": "doctorId", "value": "", "type": "string" },
    { "key": "slotId", "value": "", "type": "string" },
    { "key": "appointmentId", "value": "", "type": "string" },
    { "key": "razorpayOrderId", "value": "", "type": "string" }
  ],
  "item": [
    {
      "name": "1. Authentication",
      "item": [
        {
          "name": "Register Patient",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/api/v1/auth/register", "host": ["{{baseUrl}}"], "path": ["api", "v1", "auth", "register"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"patient@example.com\",\n  \"password\": \"SecurePass123!\",\n  \"fullName\": \"Rahul Sharma\",\n  \"phone\": \"+919876543210\",\n  \"role\": \"PATIENT\"\n}"
            }
          }
        },
        {
          "name": "Register Doctor",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/api/v1/auth/register", "host": ["{{baseUrl}}"], "path": ["api", "v1", "auth", "register"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"doctor@example.com\",\n  \"password\": \"SecureDoc123!\",\n  \"fullName\": \"Dr. Sarah Khan\",\n  \"phone\": \"+919876543211\",\n  \"role\": \"DOCTOR\",\n  \"specialty\": \"Cardiology\",\n  \"licenseNumber\": \"MCI-2023-9988\",\n  \"experienceYears\": 8,\n  \"consultationFee\": 600.00\n}"
            }
          }
        },
        {
          "name": "Login (Patient / Doctor / Admin)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.data && jsonData.data.accessToken) {",
                  "    pm.collectionVariables.set('patientToken', jsonData.data.accessToken);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/api/v1/auth/login", "host": ["{{baseUrl}}"], "path": ["api", "v1", "auth", "login"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"identifier\": \"patient@example.com\",\n  \"password\": \"SecurePass123!\"\n}"
            }
          }
        },
        {
          "name": "Google / Firebase Social Sign-In",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/api/v1/auth/firebase-login", "host": ["{{baseUrl}}"], "path": ["api", "v1", "auth", "firebase-login"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"idToken\": \"<FIREBASE_GOOGLE_ID_TOKEN>\",\n  \"role\": \"PATIENT\"\n}"
            }
          }
        },
        {
          "name": "Refresh Token",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/api/v1/auth/refresh", "host": ["{{baseUrl}}"], "path": ["api", "v1", "auth", "refresh"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refreshToken\": \"<YOUR_REFRESH_TOKEN>\"\n}"
            }
          }
        }
      ]
    },
    {
      "name": "2. Doctor Discovery",
      "item": [
        {
          "name": "Search Doctors",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{patientToken}}" }],
            "url": {
              "raw": "{{baseUrl}}/api/v1/doctors?search=Cardiology&page=0&size=10",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "doctors"],
              "query": [
                { "key": "search", "value": "Cardiology" },
                { "key": "page", "value": "0" },
                { "key": "size", "value": "10" }
              ]
            }
          }
        },
        {
          "name": "Get Doctor Details by ID",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{patientToken}}" }],
            "url": { "raw": "{{baseUrl}}/api/v1/doctors/{{doctorId}}", "host": ["{{baseUrl}}"], "path": ["api", "v1", "doctors", "{{doctorId}}"] }
          }
        }
      ]
    },
    {
      "name": "3. Scheduling & Slot Locking",
      "item": [
        {
          "name": "Get Doctor Available Slots",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{patientToken}}" }],
            "url": {
              "raw": "{{baseUrl}}/api/v1/doctors/{{doctorId}}/slots?date=2026-09-01",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "doctors", "{{doctorId}}", "slots"],
              "query": [{ "key": "date", "value": "2026-09-01" }]
            }
          }
        },
        {
          "name": "Lock Slot (Atomic 5-min Hold)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{patientToken}}" }
            ],
            "url": { "raw": "{{baseUrl}}/api/v1/slots/{{slotId}}/lock", "host": ["{{baseUrl}}"], "path": ["api", "v1", "slots", "{{slotId}}", "lock"] }
          }
        }
      ]
    },
    {
      "name": "4. Payments (Razorpay)",
      "item": [
        {
          "name": "Initiate Payment Order",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.data && jsonData.data.gatewayOrderId) {",
                  "    pm.collectionVariables.set('razorpayOrderId', jsonData.data.gatewayOrderId);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{patientToken}}" }
            ],
            "url": { "raw": "{{baseUrl}}/api/v1/payments/initiate", "host": ["{{baseUrl}}"], "path": ["api", "v1", "payments", "initiate"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"appointmentId\": \"{{appointmentId}}\"\n}"
            }
          }
        },
        {
          "name": "Verify Payment Signature & Confirm",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{patientToken}}" }
            ],
            "url": { "raw": "{{baseUrl}}/api/v1/payments/verify", "host": ["{{baseUrl}}"], "path": ["api", "v1", "payments", "verify"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"razorpayOrderId\": \"{{razorpayOrderId}}\",\n  \"razorpayPaymentId\": \"pay_test_sample123\",\n  \"razorpaySignature\": \"<HMAC_SHA256_SIGNATURE>\"\n}"
            }
          }
        }
      ]
    },
    {
      "name": "5. Appointment Lifecycle",
      "item": [
        {
          "name": "Book Appointment (PENDING)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{patientToken}}" }
            ],
            "url": { "raw": "{{baseUrl}}/api/v1/appointments", "host": ["{{baseUrl}}"], "path": ["api", "v1", "appointments"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"doctorId\": \"{{doctorId}}\",\n  \"slotId\": \"{{slotId}}\",\n  \"type\": \"ONLINE\",\n  \"chiefComplaint\": \"Mild chest pain and shortness of breath during morning jog.\"\n}"
            }
          }
        },
        {
          "name": "Patient: View My Appointments",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{patientToken}}" }],
            "url": { "raw": "{{baseUrl}}/api/v1/appointments?page=0&size=10", "host": ["{{baseUrl}}"], "path": ["api", "v1", "appointments"] }
          }
        },
        {
          "name": "Doctor: View My Schedule",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{doctorToken}}" }],
            "url": { "raw": "{{baseUrl}}/api/v1/appointments/doctor?status=CONFIRMED,IN_PROGRESS&page=0&size=10", "host": ["{{baseUrl}}"], "path": ["api", "v1", "appointments", "doctor"] }
          }
        },
        {
          "name": "Doctor: Start Consultation (CONFIRMED -> IN_PROGRESS)",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Authorization", "value": "Bearer {{doctorToken}}" }],
            "url": { "raw": "{{baseUrl}}/api/v1/appointments/{{appointmentId}}/start", "host": ["{{baseUrl}}"], "path": ["api", "v1", "appointments", "{{appointmentId}}", "start"] }
          }
        },
        {
          "name": "Doctor: Complete Consultation with Notes (IN_PROGRESS -> COMPLETED)",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{doctorToken}}" }
            ],
            "url": { "raw": "{{baseUrl}}/api/v1/appointments/{{appointmentId}}/complete", "host": ["{{baseUrl}}"], "path": ["api", "v1", "appointments", "{{appointmentId}}", "complete"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"notes\": \"Patient examined via video call. Blood pressure normal. Advised lifestyle changes.\",\n  \"diagnosis\": \"Mild exertional angina / muscle strain\",\n  \"prescription\": \"Tab Paracetamol 650mg SOS, Tab Sorbitrate 5mg if chest discomfort recurs. ECG advised.\"\n}"
            }
          }
        },
        {
          "name": "Cancel Appointment",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{patientToken}}" }
            ],
            "url": { "raw": "{{baseUrl}}/api/v1/appointments/{{appointmentId}}/cancel", "host": ["{{baseUrl}}"], "path": ["api", "v1", "appointments", "{{appointmentId}}", "cancel"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"reason\": \"Schedule conflict\"\n}"
            }
          }
        }
      ]
    },
    {
      "name": "6. Chat & Signaling",
      "item": [
        {
          "name": "Get Consultation Chat History",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{patientToken}}" }],
            "url": { "raw": "{{baseUrl}}/api/v1/chat/{{appointmentId}}/messages?page=0&size=50", "host": ["{{baseUrl}}"], "path": ["api", "v1", "chat", "{{appointmentId}}", "messages"] }
          }
        }
      ]
    },
    {
      "name": "7. Admin Operations",
      "item": [
        {
          "name": "Get Platform Analytics Dashboard Stats",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }],
            "url": { "raw": "{{baseUrl}}/api/v1/admin/stats", "host": ["{{baseUrl}}"], "path": ["api", "v1", "admin", "stats"] }
          }
        },
        {
          "name": "List All Platform Users",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }],
            "url": { "raw": "{{baseUrl}}/api/v1/admin/users?role=DOCTOR&page=0&size=10", "host": ["{{baseUrl}}"], "path": ["api", "v1", "admin", "users"] }
          }
        },
        {
          "name": "Suspend or Activate User",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{adminToken}}" }
            ],
            "url": { "raw": "{{baseUrl}}/api/v1/admin/users/{{doctorId}}/status", "host": ["{{baseUrl}}"], "path": ["api", "v1", "admin", "users", "{{doctorId}}", "status"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"active\": true\n}"
            }
          }
        },
        {
          "name": "Approve Doctor Verification",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }],
            "url": { "raw": "{{baseUrl}}/api/v1/admin/doctors/{{doctorId}}/verify", "host": ["{{baseUrl}}"], "path": ["api", "v1", "admin", "doctors", "{{doctorId}}", "verify"] }
          }
        },
        {
          "name": "Reject Doctor Verification",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{adminToken}}" }
            ],
            "url": { "raw": "{{baseUrl}}/api/v1/admin/doctors/{{doctorId}}/reject", "host": ["{{baseUrl}}"], "path": ["api", "v1", "admin", "doctors", "{{doctorId}}", "reject"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"reason\": \"Medical council registration certificate expired\"\n}"
            }
          }
        },
        {
          "name": "View All Appointments (Admin Oversight)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }],
            "url": { "raw": "{{baseUrl}}/api/v1/admin/appointments?status=CONFIRMED&page=0&size=10", "host": ["{{baseUrl}}"], "path": ["api", "v1", "admin", "appointments"] }
          }
        }
      ]
    }
  ]
}
